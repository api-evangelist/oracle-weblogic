  "info": {
    "_postman_id": "70c588e2-74c5-433d-a764-e4dc4a18f46e",
    "name": "Oracle WebLogic Server Oracle WebLogic Deployment Application Deployment Server Templates API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "RESTful API for deploying, undeploying, and managing application and library deployments on Oracle WebLogic Server. Supports deploying enterprise applications (EAR, WAR), shared libraries, and managing deployment lifecycle including start, stop, and redeploy operations. All deployment configuration changes require an active edit session with startEdit/activate workflow. Runtime deployment lifecycle operations (start/stop) are available through the domainRuntime tree.\n\nContact Support:\n Name: Oracle Support",
      "type": "text/plain"
    }
  }
