{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oracle WebLogic Server Oracle WebLogic Deployment Application Deployment Tasks API",
    "version": "12.2.1.3.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Oracle WebLogic Server Get status of an asynchronous task",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:7001/management/weblogic/latest/domainRuntime/tasks/:taskId",
            "params": [
              {
                "name": "taskId",
                "value": "",
                "type": "path",
                "description": "Task identifier"
              }
            ]
          },
          "docs": "Returns the current status of an asynchronous operation. Used to poll for completion of long-running operations like server start/stop."
        }
      ]
    }
  ],
  "bundled": true
}