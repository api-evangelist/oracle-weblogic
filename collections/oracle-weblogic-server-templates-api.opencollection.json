                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Oracle WebLogic Server Create a new server template"
        },
        {
          "info": {
            "name": "Oracle WebLogic Server Get a server template configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:7001/management/weblogic/latest/edit/serverTemplates/:templateName",
